# ----- Supabase -----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...                # server-only, bypasses RLS
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Only needed if your project still signs user tokens with the LEGACY HS256
# shared secret (Project Settings -> JWT Keys -> legacy JWT secret). Projects
# using asymmetric signing keys (ES256/RS256 — the current default) are verified
# against the published JWKS and need nothing here; leave it blank.
# NOTE: this is NOT the anon key, the service key, or an `sb_publishable_...` /
# `sb_secret_...` API key. Those are credentials, not signing secrets.
SUPABASE_JWT_SECRET=

# ----- Claude API -----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_SONNET_MODEL=claude-sonnet-4-6

# ----- GitHub -----
# Personal access token for reading dependency files / org activity.
# In GitHub Actions runs we also fall back to GITHUB_TOKEN which the runner injects.
GITHUB_TOKEN=ghp_xxxxx

# ----- App -----
APP_ENV=development
LOG_LEVEL=INFO
SCRAPE_RATE_LIMIT=2                        # seconds between requests per domain
MAX_COMPANIES_PER_RUN=50

# ----- Observability (optional) -----
SENTRY_DSN=
