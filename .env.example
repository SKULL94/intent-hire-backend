# ----- Supabase -----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...                # server-only, bypasses RLS
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ----- Claude API -----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_SONNET_MODEL=claude-sonnet-4-6

# ----- GitHub -----
# Personal access token for reading dependency files / org activity.
# In GitHub Actions runs we also fall back to GITHUB_TOKEN which the runner injects.
GITHUB_TOKEN=ghp_xxxxx

# ----- App -----
APP_ENV=development
LOG_LEVEL=INFO
SCRAPE_RATE_LIMIT=2                        # seconds between requests per domain
MAX_COMPANIES_PER_RUN=50

# ----- Observability (optional) -----
SENTRY_DSN=
